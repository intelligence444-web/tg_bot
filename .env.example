# Переменные окружения бота. Значения сюда НЕ пишутся: задайте их в настройках функций
# Yandex Cloud Functions (см. docs/deploy.md) или в локальном файле .env, который не попадает в git.

# --- Функция bot (bot.main.handler) ---

# Токен бота от @BotFather (вида 123456789:AA...). Нужен и функции daily.
BOT_TOKEN=
# Ключ API Kie.ai (kie.ai -> API Key).
KIE_API_KEY=
# Секрет вебхука: 32+ случайных символа из латинских букв, цифр, _ и -.
# Тот же, что передаётся в setWebhook (secret_token); Telegram присылает его в заголовке X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=
# Числовой ID чата администратора (например, через @userinfobot) — сюда приходит «Пополни баланс Kie». Можно оставить пустым.
ADMIN_CHAT_ID=
# Основная модель распознавания фото: openai:<модель> или claude:<модель>, например openai:gemini-3-pro.
VISION_PRIMARY=
# Запасная модель в том же формате, например openai:gemini-2.5-pro. Можно оставить пустым.
VISION_FALLBACK=
# Ссылка на страницу политики обработки персональных данных (показывается в /start).
PRIVACY_URL=

# --- YDB (нужны обеим функциям: bot и daily) ---

# Эндпоинт базы — часть строки подключения до "/?database=", например grpcs://ydb.serverless.yandexcloud.net:2135
YDB_ENDPOINT=
# Путь базы — часть строки подключения после "database=", например /ru-central1/b1g.../etn...
YDB_DATABASE=
# 1 — брать токен из сервиса метаданных (в Cloud Functions с сервисным аккаунтом ставить 1).
# Локально не задавайте; вместо этого — одна из переменных ydb, например YDB_ANONYMOUS_CREDENTIALS=1
# (локальная база) или YDB_ACCESS_TOKEN_CREDENTIALS=<IAM-токен>.
YDB_METADATA_CREDENTIALS=
